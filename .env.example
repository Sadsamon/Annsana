# ── Core (required everywhere) ────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-never-commit-this
DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com,yourdomain.com

# ── Database ──────────────────────────────────────────────────────────
# Neon (free): paste the connection string from your Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/annsana?sslmode=require

# ── Media storage — Cloudflare R2 (free 10 GB) ───────────────────────
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=annsana-media
AWS_S3_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto

# ── Celery / Redis ────────────────────────────────────────────────────
# Free tier: skip Redis entirely — images process synchronously
CELERY_ALWAYS_EAGER=True
# When you add Redis later (e.g. Upstash free):
# CELERY_BROKER_URL=rediss://default:password@host:port

# ── Trust layer thresholds ────────────────────────────────────────────
ENTRY_VERIFICATION_THRESHOLD=3
LINK_VERIFICATION_THRESHOLD=2
GRIOT_THRESHOLD=100
MAX_ACTIVE_INVITES_PER_GRIOT=3

# ── Upload limits ─────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
