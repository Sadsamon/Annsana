# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Core ---
DJANGO_SETTINGS_MODULE=annsana.settings.development
SECRET_KEY=change-this-to-a-random-50-char-string
DEBUG=True

# --- Database ---
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://annsana:annsana@localhost:5432/annsana

# --- Hosts ---
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Media (production only — leave blank in development) ---
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
