# ── Core ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Database (production: PostgreSQL) ────────────────────────────────
DATABASE_URL=postgres://annsana:password@db:5432/annsana
POSTGRES_PASSWORD=change-me

# ── Redis / Celery ────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0

# ── AWS S3 Media Storage ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=annsana-media
AWS_S3_REGION_NAME=us-east-1

# ── Image upload limits ───────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10

# ── Trust layer thresholds ────────────────────────────────────────────
ENTRY_VERIFICATION_THRESHOLD=3
LINK_VERIFICATION_THRESHOLD=2
GRIOT_THRESHOLD=100
MAX_ACTIVE_INVITES_PER_GRIOT=3
