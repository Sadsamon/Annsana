{
  "name": "annsana-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build pipeline for the Annsana Django project.",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --minify",
    "watch:css": "tailwindcss -i ./static/css/input.css -o ./static/css/output.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0"
  }
}
